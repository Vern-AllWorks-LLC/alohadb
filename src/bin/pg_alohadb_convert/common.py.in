# --- generated by generate.py from rename_map.json ---

MAP = @MAP@

_names = dict(MAP["tokens"])
_names.update(MAP["exts"])
_prefixes = sorted(_names, key=len, reverse=True)
_ident = re.compile(r"(?<![A-Za-z0-9_$])alohadb_[a-z0-9_]+")
_guc = re.compile(r"(?<![A-Za-z0-9_$])(" +
                  "|".join(re.escape(k) for k in sorted(MAP["gucs"], key=len, reverse=True)) +
                  r")(?![a-z0-9_])")
_other = dict(MAP["programs"])
_other.update(MAP["files"])
_prog = re.compile(r"(?<![A-Za-z0-9_.$])(" +
                   "|".join(re.escape(k) for k in sorted(_other, key=len, reverse=True)) +
                   r")(?![A-Za-z0-9_])")


def new_ident(name):
    """New name for an alohadb_* identifier, or None if it is not ours."""
    if name in _names:
        return _names[name]
    for old in _prefixes:
        if name.startswith(old + "_"):
            return _names[old] + name[len(old):]
    return None


def convert(text, counts):
    def ident(m):
        new = new_ident(m.group(0))
        if new is None:
            return m.group(0)
        counts[(m.group(0), new)] += 1
        return new

    def table(mapping):
        def repl(m):
            new = mapping[m.group(1)]
            counts[(m.group(1), new)] += 1
            return new
        return repl

    text = _guc.sub(table(MAP["gucs"]), text)
    text = _ident.sub(ident, text)
    text = _prog.sub(table(_other), text)
    return text


