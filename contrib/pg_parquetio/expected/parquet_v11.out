-- pg_parquetio v1.1 regression test
-- Tests: extension upgrade, function signatures, path validation
CREATE EXTENSION pg_parquetio VERSION '1.0';
-- Verify v1.0 read_parquet has 1 argument
SELECT proname, pronargs
FROM   pg_proc
WHERE  proname = 'read_parquet'
  AND  pronargs = 1;
   proname    | pronargs 
--------------+----------
 read_parquet |        1
(1 row)

-- Upgrade to 1.1
ALTER EXTENSION pg_parquetio UPDATE TO '1.1';
-- After upgrade: read_parquet now has 2 arguments (file_path, options)
SELECT proname, pronargs
FROM   pg_proc
WHERE  proname = 'read_parquet';
   proname    | pronargs 
--------------+----------
 read_parquet |        2
(1 row)

-- Old 1-arg variant is gone
SELECT count(*) AS one_arg_count
FROM   pg_proc
WHERE  proname = 'read_parquet' AND pronargs = 1;
 one_arg_count 
---------------
             0
(1 row)

-- read_csv and read_json still present (unchanged)
SELECT proname, pronargs
FROM   pg_proc
WHERE  proname IN ('read_csv', 'read_json')
ORDER BY proname;
  proname  | pronargs 
-----------+----------
 read_csv  |        3
 read_json |        1
(2 rows)

-- -----------------------------------------------------------------------
-- Path validation errors
-- -----------------------------------------------------------------------
\set ON_ERROR_STOP 0
-- Non-existent file
SELECT * FROM read_parquet('/tmp/does_not_exist_alohadb_test.parquet');
ERROR:  could not open file "/tmp/does_not_exist_alohadb_test.parquet": No such file or directory
\set ON_ERROR_STOP 1
\set ON_ERROR_STOP 0
-- Path not in allowed directories
SELECT * FROM read_parquet('/etc/passwd');
ERROR:  file path "/etc/passwd" is not in an allowed directory
\set ON_ERROR_STOP 1
\set ON_ERROR_STOP 0
-- Valid path but not a Parquet file
SELECT * FROM read_parquet('/dev/null');
ERROR:  file path "/dev/null" is not in an allowed directory
\set ON_ERROR_STOP 1
-- -----------------------------------------------------------------------
-- read_csv still works (smoke test with a temp file)
-- -----------------------------------------------------------------------
-- Write a small CSV to /tmp using pg_file_write (if available)
DO $$
BEGIN
    IF EXISTS (SELECT 1 FROM pg_proc WHERE proname = 'pg_file_write') THEN
        PERFORM pg_file_write('/tmp/pg_test.csv',
            'name,age,city' || chr(10) ||
            'alice,30,NYC'  || chr(10) ||
            'bob,25,LA'     || chr(10),
            false);
    END IF;
END $$;
-- Only run if file was written
DO $$
BEGIN
    IF EXISTS (SELECT 1 FROM pg_proc WHERE proname = 'pg_file_write') THEN
        PERFORM count(*) FROM read_csv('/tmp/pg_test.csv');
    END IF;
END $$;
-- -----------------------------------------------------------------------
-- Cleanup
-- -----------------------------------------------------------------------
DROP EXTENSION pg_parquetio;
