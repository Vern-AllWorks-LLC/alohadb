SELECT ndarray_map('m', 'x', 'mul');
ERROR:  map op requires exactly one scalar argument
SELECT ndarray_map('m', 'x', 'sqrt', 2);
ERROR:  map op does not take a scalar argument
SELECT ndarray_map('m', 'x', 'clip', 5, 1);
