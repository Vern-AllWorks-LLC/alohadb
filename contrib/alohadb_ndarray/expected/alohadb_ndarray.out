SELECT ndarray_create(NULL, 'float64', '{5}', '{2}');
ERROR:  name, dtype, shape, chunk_shape, codec and fill_value must not be null
SELECT ndarray_reduce('m', 'median');
ERROR:  invalid reduce op "median"
HINT:  Valid ops are sum, mean, min, max, std and count_nonzero.
SELECT ndarray_reduce_axis('m', 'sum', 2);
ERROR:  axis 2 is out of range for ndarray with 2 dimensions
SELECT ndarray_map('m', 'm2', 'mul', 2);
