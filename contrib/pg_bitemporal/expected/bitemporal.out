--
-- pg_bitemporal regression test
--
CREATE EXTENSION pg_bitemporal;
SET timezone = 'UTC';
SET datestyle = 'ISO, YMD';
CREATE TABLE price (
    product_id int  NOT NULL,
    price      numeric NOT NULL,
    note       text
);
-- unique constraint on the key alone is rejected
CREATE TABLE bad_pk (id int PRIMARY KEY, v int);
SELECT bitemporal_enable('bad_pk', ARRAY['id']);
ERROR:  unique index bad_pk_pkey on bad_pk does not include column "valid_from"
HINT:  A bitemporal table stores several versions per key; include the valid_from column in primary keys / unique constraints.
CONTEXT:  PL/pgSQL function bitemporal_enable(regclass,text[],text,text) line 61 at RAISE
-- unknown key column
SELECT bitemporal_enable('price', ARRAY['nope']);
ERROR:  column "nope" of key does not exist in price
CONTEXT:  PL/pgSQL function bitemporal_enable(regclass,text[],text,text) line 40 at RAISE
SELECT bitemporal_enable('price', ARRAY['product_id']);
 bitemporal_enable 
-------------------
 price_history
(1 row)

SELECT table_name, history_table, key_columns, valid_from_col, valid_to_col
  FROM bitemporal_tables;
 table_name | history_table | key_columns  | valid_from_col | valid_to_col 
------------+---------------+--------------+----------------+--------------
 price      | price_history | {product_id} | valid_from     | valid_to
(1 row)

\d price
                                        Table "public.price"
   Column   |           Type           | Collation | Nullable |               Default                
------------+--------------------------+-----------+----------+--------------------------------------
 product_id | integer                  |           | not null | 
 price      | numeric                  |           | not null | 
 note       | text                     |           |          | 
 valid_from | timestamp with time zone |           | not null | 
 valid_to   | timestamp with time zone |           | not null | 'infinity'::timestamp with time zone
 sys_from   | timestamp with time zone |           | not null | 
 sys_to     | timestamp with time zone |           | not null | 'infinity'::timestamp with time zone
Indexes:
    "price_product_id_valid_from_idx" btree (product_id, valid_from)
Check constraints:
    "price_check" CHECK (valid_from < valid_to)
Triggers:
    bitemporal_no_truncate BEFORE TRUNCATE ON price FOR EACH STATEMENT EXECUTE FUNCTION bitemporal_no_truncate_trigger()
    bitemporal_overlap AFTER INSERT OR UPDATE ON price FOR EACH ROW EXECUTE FUNCTION bitemporal_overlap_trigger()
    bitemporal_versioning BEFORE INSERT OR DELETE OR UPDATE ON price FOR EACH ROW EXECUTE FUNCTION bitemporal_versioning_trigger()

-- ---------------------------------------------------------------
-- 1. Initial load, recorded at system time 2024-01-10
-- ---------------------------------------------------------------
SET pg_bitemporal.system_time = '2024-01-10 00:00:00+00';
INSERT INTO price (product_id, price, valid_from) VALUES
    (1, 100, '2024-01-01'),
    (2,  50, '2024-01-01');
SELECT product_id, price, valid_from, valid_to, sys_from, sys_to
  FROM price ORDER BY product_id, valid_from;
 product_id | price |       valid_from       | valid_to |        sys_from        |  sys_to  
------------+-------+------------------------+----------+------------------------+----------
          1 |   100 | 2024-01-01 00:00:00+00 | infinity | 2024-01-10 00:00:00+00 | infinity
          2 |    50 | 2024-01-01 00:00:00+00 | infinity | 2024-01-10 00:00:00+00 | infinity
(2 rows)

-- overlapping valid period for the same key is rejected
INSERT INTO price (product_id, price, valid_from, valid_to)
    VALUES (1, 999, '2024-06-01', '2024-07-01');
ERROR:  overlapping valid periods for key {"product_id": 1} in price
DETAIL:  New period [2024-06-01T00:00:00+00:00, 2024-07-01T00:00:00+00:00) overlaps an existing current row.
CONTEXT:  PL/pgSQL function bitemporal_overlap_trigger() line 18 at RAISE
-- empty valid period is rejected
INSERT INTO price (product_id, price, valid_from, valid_to)
    VALUES (3, 1, '2024-06-01', '2024-06-01');
ERROR:  new row for relation "price" violates check constraint "price_check"
DETAIL:  Failing row contains (3, 1, null, 2024-06-01 00:00:00+00, 2024-06-01 00:00:00+00, 2024-01-10 00:00:00+00, infinity).
-- ---------------------------------------------------------------
-- 2. Retroactive correction, recorded 2024-02-15: the price of
--    product 1 had really been 110 since 2024-02-01.
-- ---------------------------------------------------------------
SET pg_bitemporal.system_time = '2024-02-15 00:00:00+00';
SELECT bitemporal_update('price', '{"product_id": 1}', '2024-02-01', NULL,
                         '{"price": 110, "note": "correction"}');
 bitemporal_update 
-------------------
                 1
(1 row)

SELECT product_id, price, note, valid_from, valid_to, sys_from, sys_to
  FROM price ORDER BY product_id, valid_from;
 product_id | price |    note    |       valid_from       |        valid_to        |        sys_from        |  sys_to  
------------+-------+------------+------------------------+------------------------+------------------------+----------
          1 |   100 |            | 2024-01-01 00:00:00+00 | 2024-02-01 00:00:00+00 | 2024-02-15 00:00:00+00 | infinity
          1 |   110 | correction | 2024-02-01 00:00:00+00 | infinity               | 2024-02-15 00:00:00+00 | infinity
          2 |    50 |            | 2024-01-01 00:00:00+00 | infinity               | 2024-01-10 00:00:00+00 | infinity
(3 rows)

-- ---------------------------------------------------------------
-- 3. FOR PORTION OF split, recorded 2024-03-20: promotion price 90
--    for product 1 during [2024-03-01, 2024-03-15).
-- ---------------------------------------------------------------
SET pg_bitemporal.system_time = '2024-03-20 00:00:00+00';
SELECT bitemporal_update('price', '{"product_id": "1"}', '2024-03-01', '2024-03-15',
                         '{"price": 90, "note": "promo"}');
 bitemporal_update 
-------------------
                 1
(1 row)

SELECT product_id, price, note, valid_from, valid_to, sys_from, sys_to
  FROM price ORDER BY product_id, valid_from;
 product_id | price |    note    |       valid_from       |        valid_to        |        sys_from        |  sys_to  
------------+-------+------------+------------------------+------------------------+------------------------+----------
          1 |   100 |            | 2024-01-01 00:00:00+00 | 2024-02-01 00:00:00+00 | 2024-02-15 00:00:00+00 | infinity
          1 |   110 | correction | 2024-02-01 00:00:00+00 | 2024-03-01 00:00:00+00 | 2024-03-20 00:00:00+00 | infinity
          1 |    90 | promo      | 2024-03-01 00:00:00+00 | 2024-03-15 00:00:00+00 | 2024-03-20 00:00:00+00 | infinity
          1 |   110 | correction | 2024-03-15 00:00:00+00 | infinity               | 2024-03-20 00:00:00+00 | infinity
          2 |    50 |            | 2024-01-01 00:00:00+00 | infinity               | 2024-01-10 00:00:00+00 | infinity
(5 rows)

-- ---------------------------------------------------------------
-- 4. Sequenced delete, recorded 2024-04-01: product 2 discontinued
--    from 2024-04-01 on.
-- ---------------------------------------------------------------
SET pg_bitemporal.system_time = '2024-04-01 00:00:00+00';
SELECT bitemporal_delete('price', '{"product_id": 2}', '2024-04-01', NULL);
 bitemporal_delete 
-------------------
                 1
(1 row)

-- a non-overlapping new period is fine
INSERT INTO price (product_id, price, valid_from) VALUES (2, 55, '2024-05-01');
SELECT product_id, price, valid_from, valid_to, sys_from
  FROM price ORDER BY product_id, valid_from;
 product_id | price |       valid_from       |        valid_to        |        sys_from        
------------+-------+------------------------+------------------------+------------------------
          1 |   100 | 2024-01-01 00:00:00+00 | 2024-02-01 00:00:00+00 | 2024-02-15 00:00:00+00
          1 |   110 | 2024-02-01 00:00:00+00 | 2024-03-01 00:00:00+00 | 2024-03-20 00:00:00+00
          1 |    90 | 2024-03-01 00:00:00+00 | 2024-03-15 00:00:00+00 | 2024-03-20 00:00:00+00
          1 |   110 | 2024-03-15 00:00:00+00 | infinity               | 2024-03-20 00:00:00+00
          2 |    50 | 2024-01-01 00:00:00+00 | 2024-04-01 00:00:00+00 | 2024-04-01 00:00:00+00
          2 |    55 | 2024-05-01 00:00:00+00 | infinity               | 2024-04-01 00:00:00+00
(6 rows)

-- history: every superseded version with its system period closed
SELECT product_id, price, note, valid_from, valid_to, sys_from, sys_to
  FROM price_history ORDER BY product_id, sys_from, valid_from;
 product_id | price |    note    |       valid_from       | valid_to |        sys_from        |         sys_to         
------------+-------+------------+------------------------+----------+------------------------+------------------------
          1 |   100 |            | 2024-01-01 00:00:00+00 | infinity | 2024-01-10 00:00:00+00 | 2024-02-15 00:00:00+00
          1 |   110 | correction | 2024-02-01 00:00:00+00 | infinity | 2024-02-15 00:00:00+00 | 2024-03-20 00:00:00+00
          2 |    50 |            | 2024-01-01 00:00:00+00 | infinity | 2024-01-10 00:00:00+00 | 2024-04-01 00:00:00+00
(3 rows)

RESET pg_bitemporal.system_time;
-- ---------------------------------------------------------------
-- 5. "What did we believe on date X about date Y?"
-- ---------------------------------------------------------------
-- before anything was recorded
SELECT product_id, price FROM bitemporal_as_of(NULL::price, '2024-02-10', '2024-01-05');
 product_id | price 
------------+-------
(0 rows)

-- believed on 2024-01-20 about 2024-02-10: original price 100
SELECT product_id, price FROM bitemporal_as_of(NULL::price, '2024-02-10', '2024-01-20')
 ORDER BY product_id;
 product_id | price 
------------+-------
          1 |   100
          2 |    50
(2 rows)

-- believed on 2024-02-20 about 2024-02-10: corrected price 110
SELECT product_id, price FROM bitemporal_as_of(NULL::price, '2024-02-10', '2024-02-20')
 ORDER BY product_id;
 product_id | price 
------------+-------
          1 |   110
          2 |    50
(2 rows)

-- believed on 2024-02-20 about 2024-03-05: 110 (promo not yet known)
SELECT product_id, price, note FROM bitemporal_as_of(NULL::price, '2024-03-05', '2024-02-20')
 ORDER BY product_id;
 product_id | price |    note    
------------+-------+------------
          1 |   110 | correction
          2 |    50 | 
(2 rows)

-- believed on 2024-03-25 about 2024-03-05: promo price 90
SELECT product_id, price, note FROM bitemporal_as_of(NULL::price, '2024-03-05', '2024-03-25')
 ORDER BY product_id;
 product_id | price | note  
------------+-------+-------
          1 |    90 | promo
          2 |    50 | 
(2 rows)

-- believed on 2024-03-25 about 2024-01-15: 100 (before the correction window)
SELECT product_id, price FROM bitemporal_as_of(NULL::price, '2024-01-15', '2024-03-25')
 ORDER BY product_id;
 product_id | price 
------------+-------
          1 |   100
          2 |    50
(2 rows)

-- believed now about 2024-04-15: product 2 has no valid price
SELECT product_id, price FROM bitemporal_as_of(NULL::price, '2024-04-15')
 ORDER BY product_id;
 product_id | price 
------------+-------
          1 |   110
(1 row)

-- believed now about 2024-06-01
SELECT product_id, price FROM bitemporal_as_of(NULL::price, '2024-06-01')
 ORDER BY product_id;
 product_id | price 
------------+-------
          1 |   110
          2 |    55
(2 rows)

-- believed on 2024-03-25 about 2024-06-01: product 2 still at 50
SELECT product_id, price FROM bitemporal_as_of(NULL::price, '2024-06-01', '2024-03-25')
 ORDER BY product_id;
 product_id | price 
------------+-------
          1 |   110
          2 |    50
(2 rows)

-- whole valid timeline of product 1 as known on 2024-02-20
SELECT product_id, price, valid_from, valid_to
  FROM bitemporal_as_of(NULL::price, NULL, '2024-02-20')
 WHERE product_id = 1 ORDER BY valid_from;
 product_id | price |       valid_from       |        valid_to        
------------+-------+------------------------+------------------------
          1 |   100 | 2024-01-01 00:00:00+00 | 2024-02-01 00:00:00+00
          1 |   110 | 2024-02-01 00:00:00+00 | infinity
(2 rows)

-- full bitemporal history of one key
SELECT entity_key, valid_from, valid_to, sys_from, sys_to, is_current, row_data
  FROM bitemporal_history('price', '{"product_id": 1}');
    entity_key     |       valid_from       |        valid_to        |        sys_from        |         sys_to         | is_current |               row_data               
-------------------+------------------------+------------------------+------------------------+------------------------+------------+--------------------------------------
 {"product_id": 1} | 2024-01-01 00:00:00+00 | infinity               | 2024-01-10 00:00:00+00 | 2024-02-15 00:00:00+00 | f          | {"note": null, "price": 100}
 {"product_id": 1} | 2024-01-01 00:00:00+00 | 2024-02-01 00:00:00+00 | 2024-02-15 00:00:00+00 | infinity               | t          | {"note": null, "price": 100}
 {"product_id": 1} | 2024-02-01 00:00:00+00 | infinity               | 2024-02-15 00:00:00+00 | 2024-03-20 00:00:00+00 | f          | {"note": "correction", "price": 110}
 {"product_id": 1} | 2024-02-01 00:00:00+00 | 2024-03-01 00:00:00+00 | 2024-03-20 00:00:00+00 | infinity               | t          | {"note": "correction", "price": 110}
 {"product_id": 1} | 2024-03-01 00:00:00+00 | 2024-03-15 00:00:00+00 | 2024-03-20 00:00:00+00 | infinity               | t          | {"note": "promo", "price": 90}
 {"product_id": 1} | 2024-03-15 00:00:00+00 | infinity               | 2024-03-20 00:00:00+00 | infinity               | t          | {"note": "correction", "price": 110}
(6 rows)

SELECT count(*) AS versions_all_keys FROM bitemporal_history('price');
 versions_all_keys 
-------------------
                 9
(1 row)

-- ---------------------------------------------------------------
-- 6. Plain (non-sequenced) DML is versioned too; system time defaults
--    to the transaction timestamp.
-- ---------------------------------------------------------------
BEGIN;
UPDATE price SET note = 'restocked' WHERE product_id = 2 AND valid_from = '2024-05-01';
SELECT note, sys_from = now() AS sys_from_is_now, sys_to = 'infinity' AS open
  FROM price WHERE product_id = 2 AND valid_from = '2024-05-01';
   note    | sys_from_is_now | open 
-----------+-----------------+------
 restocked | t               | t
(1 row)

-- second change in the same transaction: no zero-length history version
UPDATE price SET note = 'restocked twice' WHERE product_id = 2 AND valid_from = '2024-05-01';
SELECT count(*) AS hist_rows_closed_now FROM price_history WHERE sys_to = now();
 hist_rows_closed_now 
----------------------
                    1
(1 row)

COMMIT;
SELECT price, note FROM bitemporal_as_of(NULL::price, '2024-06-01')
 WHERE product_id = 2;
 price |      note       
-------+-----------------
    55 | restocked twice
(1 row)

SELECT price, note FROM bitemporal_as_of(NULL::price, '2024-06-01', '2024-04-02')
 WHERE product_id = 2;
 price | note 
-------+------
    55 | 
(1 row)

-- direct UPDATE that creates an overlap is rejected
UPDATE price SET valid_to = '2024-06-01' WHERE product_id = 2 AND valid_from = '2024-01-01';
ERROR:  overlapping valid periods for key {"product_id": 2} in price
DETAIL:  New period [2024-01-01T00:00:00+00:00, 2024-06-01T00:00:00+00:00) overlaps an existing current row.
CONTEXT:  PL/pgSQL function bitemporal_overlap_trigger() line 18 at RAISE
-- system time may not go backwards for a row version
SET pg_bitemporal.system_time = '2023-01-01 00:00:00+00';
DELETE FROM price WHERE product_id = 1;
ERROR:  system time 2023-01-01 00:00:00+00 precedes the start 2024-02-15 00:00:00+00 of the row version being superseded in price
HINT:  A later transaction already modified this row; retry the transaction.
CONTEXT:  PL/pgSQL function bitemporal_versioning_trigger() line 12 at RAISE
RESET pg_bitemporal.system_time;
-- TRUNCATE is refused (would lose history)
TRUNCATE price;
ERROR:  cannot TRUNCATE bitemporal table price
HINT:  Use DELETE (history is kept) or bitemporal_disable() first.
CONTEXT:  PL/pgSQL function bitemporal_no_truncate_trigger() line 3 at RAISE
-- ---------------------------------------------------------------
-- 7. Error handling of the sequenced functions
-- ---------------------------------------------------------------
SELECT bitemporal_update('price', '{"product_id": 1}', NULL, NULL, '{"product_id": 7}');
ERROR:  column "product_id" cannot be changed by bitemporal_update
HINT:  Key and period columns are managed by the sequenced update itself.
CONTEXT:  PL/pgSQL function _bt_portion(regclass,jsonb,timestamp with time zone,timestamp with time zone,jsonb,boolean) line 28 at RAISE
SELECT bitemporal_update('price', '{"product_id": 1}', NULL, NULL, '{"nosuch": 7}');
ERROR:  column "nosuch" does not exist or is not writable in price
CONTEXT:  PL/pgSQL function _bt_portion(regclass,jsonb,timestamp with time zone,timestamp with time zone,jsonb,boolean) line 32 at RAISE
SELECT bitemporal_update('price', '{"id": 1}', NULL, NULL, '{"price": 7}');
ERROR:  "id" is not a key column of price (key columns: {product_id})
CONTEXT:  PL/pgSQL function _bt_norm_key(bitemporal_tables,jsonb) line 12 at RAISE
PL/pgSQL function _bt_portion(regclass,jsonb,timestamp with time zone,timestamp with time zone,jsonb,boolean) line 14 at assignment
SELECT bitemporal_update('price', '{}', NULL, NULL, '{"price": 7}');
ERROR:  key column "product_id" missing from key {}
CONTEXT:  PL/pgSQL function _bt_norm_key(bitemporal_tables,jsonb) line 21 at RAISE
PL/pgSQL function _bt_portion(regclass,jsonb,timestamp with time zone,timestamp with time zone,jsonb,boolean) line 14 at assignment
SELECT bitemporal_delete('price', '{"product_id": 1}', '2024-05-01', '2024-04-01');
ERROR:  empty period: valid_from (2024-05-01 00:00:00+00) must be earlier than valid_to (2024-04-01 00:00:00+00)
CONTEXT:  PL/pgSQL function _bt_portion(regclass,jsonb,timestamp with time zone,timestamp with time zone,jsonb,boolean) line 18 at RAISE
SELECT bitemporal_update('bad_pk', '{"id": 1}', NULL, NULL, '{"v": 1}');
ERROR:  table bad_pk is not bitemporal
HINT:  Call bitemporal_enable() first.
CONTEXT:  PL/pgSQL function _bt_conf(regclass) line 7 at RAISE
PL/pgSQL function _bt_portion(regclass,jsonb,timestamp with time zone,timestamp with time zone,jsonb,boolean) line 13 at assignment
SELECT * FROM bitemporal_as_of(NULL::bad_pk, now());
ERROR:  table bad_pk is not bitemporal
HINT:  Call bitemporal_enable() first.
CONTEXT:  PL/pgSQL function _bt_conf(regclass) line 7 at RAISE
PL/pgSQL function bitemporal_as_of(anyelement,timestamp with time zone,timestamp with time zone) line 14 at assignment
-- no matching version: nothing happens
SELECT bitemporal_delete('price', '{"product_id": 42}', NULL, NULL);
 bitemporal_delete 
-------------------
                 0
(1 row)

-- ---------------------------------------------------------------
-- 8. Composite key, custom period column names, pre-existing rows
-- ---------------------------------------------------------------
CREATE TABLE emp_dept (
    company text,
    emp_no  int,
    dept    text,
    eff_from timestamptz,
    eff_to   timestamptz
);
INSERT INTO emp_dept VALUES ('acme', 1, 'R&D', '2020-01-01', NULL);
SET pg_bitemporal.system_time = '2024-01-01 00:00:00+00';
SELECT bitemporal_enable('emp_dept', ARRAY['company', 'emp_no'], 'eff_from', 'eff_to');
 bitemporal_enable 
-------------------
 emp_dept_history
(1 row)

SELECT company, emp_no, dept, eff_from, eff_to, sys_from, sys_to FROM emp_dept;
 company | emp_no | dept |        eff_from        |  eff_to  |        sys_from        |  sys_to  
---------+--------+------+------------------------+----------+------------------------+----------
 acme    |      1 | R&D  | 2020-01-01 00:00:00+00 | infinity | 2024-01-01 00:00:00+00 | infinity
(1 row)

SET pg_bitemporal.system_time = '2024-02-01 00:00:00+00';
-- employee was in Sales during 2021 (split into three versions)
SELECT bitemporal_update('emp_dept', '{"company": "acme", "emp_no": 1}',
                         '2021-01-01', '2022-01-01', '{"dept": "Sales"}');
 bitemporal_update 
-------------------
                 1
(1 row)

RESET pg_bitemporal.system_time;
SELECT company, emp_no, dept, eff_from, eff_to FROM emp_dept ORDER BY eff_from;
 company | emp_no | dept  |        eff_from        |         eff_to         
---------+--------+-------+------------------------+------------------------
 acme    |      1 | R&D   | 2020-01-01 00:00:00+00 | 2021-01-01 00:00:00+00
 acme    |      1 | Sales | 2021-01-01 00:00:00+00 | 2022-01-01 00:00:00+00
 acme    |      1 | R&D   | 2022-01-01 00:00:00+00 | infinity
(3 rows)

SELECT dept FROM bitemporal_as_of(NULL::emp_dept, '2021-06-01', '2024-01-15');
 dept 
------
 R&D
(1 row)

SELECT dept FROM bitemporal_as_of(NULL::emp_dept, '2021-06-01', '2024-02-15');
 dept  
-------
 Sales
(1 row)

SELECT bitemporal_disable('emp_dept', true);
 bitemporal_disable 
--------------------
 
(1 row)

SELECT to_regclass('emp_dept_history') IS NULL AS history_dropped;
 history_dropped 
-----------------
 t
(1 row)

SELECT table_name FROM bitemporal_tables ORDER BY 1;
 table_name 
------------
 price
(1 row)

SELECT bitemporal_enable('price', ARRAY['product_id']);
ERROR:  table price is already bitemporal
CONTEXT:  PL/pgSQL function bitemporal_enable(regclass,text[],text,text) line 20 at RAISE
DROP TABLE emp_dept, bad_pk;
