-------------------------
 
(1 row)

ALTER TABLE thing DROP CONSTRAINT graph_messy_thing_id_ck;
INSERT INTO thing VALUES (1500);
SELECT graph_add_property_rule('messy', 'company', 'name');
 graph_add_property_rule 
-------------------------
 
(1 row)

ALTER TABLE company ALTER COLUMN name DROP NOT NULL;
INSERT INTO company VALUES (103, NULL);
SELECT * FROM graph_validate('messy');
       kind       |  label  |                             detail                              | violations 
------------------+---------+-----------------------------------------------------------------+------------
 key_collision    | person  | keys shared with vertex label thing                             |          1
 dangling_src     | rel     | loose_edges.a not found in any vertex label                     |          1
 null_dst         | rel     | loose_edges.b is NULL                                           |          1
 dangling_dst     | rel     | loose_edges.b not found in any vertex label                     |          1
 wrong_label_dst  | rel     | loose_edges.b found under another vertex label, expected person |          1
 invalid_interval | rel     | t0 >= t1                                                        |          1
 negative_weight  | rel     | w < 0 (shortest paths require non-negative weights)             |          1
 missing_required | company | name is NULL                                                    |          1
 check_failed     | thing   | id: id < 1000                                                   |          1
(9 rows)

-- ------------------------------------------------------------------
-- graph_drop removes the constraints it installed, not the data
-- ------------------------------------------------------------------
SELECT graph_drop('social');
 graph_drop 
------------
 
(1 row)

