SELECT graph_add_property_rule('social', 'nolabel', 'age');        -- error
ERROR:  label "nolabel" does not exist in graph "social"
CONTEXT:  PL/pgSQL function graph_add_property_rule(text,text,name,boolean,text) line 16 at RAISE
INSERT INTO person VALUES (4, NULL, 20);                           -- error: required
ERROR:  null value in column "name" of relation "person" violates not-null constraint
DETAIL:  Failing row contains (4, null, 20).
INSERT INTO person VALUES (4, 'dee', -1);                          -- error: check
ERROR:  new row for relation "person" violates check constraint "graph_social_person_age_ck"
DETAIL:  Failing row contains (4, dee, -1).
INSERT INTO person VALUES (4, 'dee', 50);
-- clean data validates
SELECT * FROM graph_validate('social');
 kind | label | detail | violations 
------+-------+--------+------------
