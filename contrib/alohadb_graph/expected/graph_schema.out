SELECT kind, label, table_name, definition FROM graph_describe('social');
  kind  |  label   | table_name |                                                                                                                                                                     definition                                                                                                                                                                     
--------+----------+------------+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 vertex | company  | company    | {"key_column": "id"}
 vertex | person   | person     | {"key_column": "id"}
 edge   | knows    | knows      | {"directed": true, "enforced": true, "dst_label": "person", "src_label": "person", "dst_column": "dst", "src_column": "src", "constraints": ["graph_social_knows_src_fk", "graph_social_knows_dst_fk", "graph_social_knows_valid_ck"], "weight_column": "w", "valid_to_column": "until", "on_delete_cascade": false, "valid_from_column": "since"}
 edge   | works_at | works_at   | {"directed": true, "enforced": true, "dst_label": "company", "src_label": "person", "dst_column": "company_id", "src_column": "person_id", "constraints": ["graph_social_works_at_src_fk", "graph_social_works_at_dst_fk"], "on_delete_cascade": true}
(4 rows)

-- installed constraints
SELECT conname, contype, pg_get_constraintdef(oid)
  FROM pg_constraint WHERE conrelid IN ('knows'::regclass, 'works_at'::regclass)
 ORDER BY conname;
           conname            | contype |                       pg_get_constraintdef                        
------------------------------+---------+-------------------------------------------------------------------
 graph_social_knows_dst_fk    | f       | FOREIGN KEY (dst) REFERENCES person(id)
 graph_social_knows_src_fk    | f       | FOREIGN KEY (src) REFERENCES person(id)
 graph_social_knows_valid_ck  | c       | CHECK ((since < until))
 graph_social_works_at_dst_fk | f       | FOREIGN KEY (company_id) REFERENCES company(id) ON DELETE CASCADE
 graph_social_works_at_src_fk | f       | FOREIGN KEY (person_id) REFERENCES person(id) ON DELETE CASCADE
 knows_dst_not_null           | n       | NOT NULL dst
 knows_src_not_null           | n       | NOT NULL src
 works_at_company_id_not_null | n       | NOT NULL company_id
 works_at_person_id_not_null  | n       | NOT NULL person_id
(9 rows)

-- enforced schema: an edge can never point to a missing vertex
INSERT INTO knows VALUES (1, 99, 1, '2024-01-01', NULL);           -- error: FK
ERROR:  insert or update on table "knows" violates foreign key constraint "graph_social_knows_dst_fk"
DETAIL:  Key (dst)=(99) is not present in table "person".
INSERT INTO knows VALUES (NULL, 2, 1, '2024-01-01', NULL);         -- error: NOT NULL
ERROR:  null value in column "src" of relation "knows" violates not-null constraint
DETAIL:  Failing row contains (null, 2, 1, Mon Jan 01 00:00:00 2024 PST, null).
INSERT INTO knows VALUES (1, 3, 1, '2024-05-01', '2024-01-01');    -- error: interval
ERROR:  new row for relation "knows" violates check constraint "graph_social_knows_valid_ck"
DETAIL:  Failing row contains (1, 3, 1, Wed May 01 00:00:00 2024 PDT, Mon Jan 01 00:00:00 2024 PST).
INSERT INTO works_at VALUES (1, 103);                              -- error: FK
ERROR:  insert or update on table "works_at" violates foreign key constraint "graph_social_works_at_dst_fk"
DETAIL:  Key (company_id)=(103) is not present in table "company".
DELETE FROM person WHERE id = 3;                                   -- error: referenced
ERROR:  update or delete on table "person" violates foreign key constraint "graph_social_knows_dst_fk" on table "knows"
DETAIL:  Key (id)=(3) is still referenced from table "knows".
-- ON DELETE CASCADE removes the edges of a deleted company
DELETE FROM company WHERE id = 102;
SELECT * FROM works_at ORDER BY person_id;
 person_id | company_id 
-----------+------------
         1 |        101
(1 row)

