INSERT INTO pts_embeddings (key, model_id, embedding, content_hash)
SELECT id, 4, v::vector, embedding__hash(label)
  FROM pts JOIN (VALUES (1, '[1,0.1]'), (2, '[0.9,-0.2]'), (3, '[-1,0.5]'),
                        (4, '[0.2,1]'), (5, '[-0.3,-1]')) AS x(i, v) ON x.i = pts.id;
