------------
 
(1 row)

SELECT prov_track('results', 'Result ID');
 prov_track 
------------
 
(1 row)

SELECT prov_track('samples', 'nope');
ERROR:  column "nope" of relation public.samples does not exist
CONTEXT:  PL/pgSQL function public.prov_track(regclass,text,text) line 10 at RAISE
SELECT tgname FROM pg_trigger WHERE tgrelid IN ('samples'::regclass, 'results'::regclass)
 ORDER BY tgrelid::regclass::text;
     tgname      
-----------------
 pg_measure_prov
 pg_measure_prov
(2 rows)

SET application_name = 'measure_test';
INSERT INTO samples VALUES (1, '12.5 ± 0.1 g'), (2, '13.1 ± 0.1 g');
SET pg_measure.activity = 'recalibration';
SET pg_measure.source = 'balance-3 run 42';
UPDATE samples SET mass = '12.6 ± 0.1 g' WHERE id = 1;
RESET pg_measure.activity;
RESET pg_measure.source;
SET pg_measure.used = '[{"table": "samples", "row_key": "1"}, "public.samples:2"]';
INSERT INTO results VALUES ('r-1', '1.05 ± 0.01 g/mL');
RESET pg_measure.used;
SELECT tbl, row_key, entity, activity, agent = current_user AS agent_ok, used,
       attrs->>'operation' AS op, attrs->>'application_name' AS app,
       attrs->>'source' AS source, attrs->>'session_user' = session_user AS su_ok,
       (attrs->>'backend_pid')::int = pg_backend_pid() AS pid_ok,
       attrs ? 'xid' AS has_xid
  FROM measure_provenance
 WHERE activity <> 'weighing' AND column_name IS NULL ORDER BY id;
   tbl   | row_key |       entity       |   activity    | agent_ok |                            used                            |   op   |     app      |      source      | su_ok | pid_ok | has_xid 
---------+---------+--------------------+---------------+----------+------------------------------------------------------------+--------+--------------+------------------+-------+--------+---------
 samples | 1       | public.samples:1   | ingest        | t        | []                                                         | INSERT | measure_test |                  | t     | t      | t
 samples | 2       | public.samples:2   | ingest        | t        | []                                                         | INSERT | measure_test |                  | t     | t      | t
 samples | 1       | public.samples:1   | recalibration | t        | []                                                         | UPDATE | measure_test | balance-3 run 42 | t     | t      | t
 results | r-1     | public.results:r-1 | write         | t        | [{"table": "samples", "row_key": "1"}, "public.samples:2"] | INSERT | measure_test |                  | t     | t      | t
(4 rows)

-- lineage: results r-1 <- samples 1 (3 records) and samples 2
SELECT depth, rel, key, column_name, activity
  FROM prov_lineage('results', 'r-1') ORDER BY depth, id;
 depth |   rel   | key | column_name |   activity    
-------+---------+-----+-------------+---------------
     0 | results | r-1 |             | write
     1 | samples | 1   |             | weighing
     1 | samples | 1   | mass        | calibration
     1 | samples | 1   |             | ingest
     1 | samples | 2   |             | ingest
     1 | samples | 1   |             | recalibration
(6 rows)

SELECT count(*) FROM prov_lineage('results', 'r-1', 0);
 count 
-------
     1
(1 row)

-- cycle safety: samples 2 claims to use results r-1
SELECT prov_record('samples', '2', 'feedback', used => '["public.results:r-1"]') > 0;
 ?column? 
----------
 t
(1 row)

SELECT depth, rel, key, activity FROM prov_lineage('results', 'r-1') ORDER BY depth, id;
 depth |   rel   | key |   activity    
-------+---------+-----+---------------
     0 | results | r-1 | write
     1 | samples | 1   | weighing
     1 | samples | 1   | calibration
     1 | samples | 1   | ingest
     1 | samples | 2   | ingest
     1 | samples | 1   | recalibration
     1 | samples | 2   | feedback
(7 rows)

